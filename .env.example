# Copy to .env.local for local development. Never commit real values.
# All of these are server-side only: none use a VITE_ prefix, so none reach the browser bundle.

# PostgreSQL connection string (Neon on Vercel). Leave unset locally to use the embedded PGlite database in ./data.
DATABASE_URL=

# Optional: enables the AI assistant (Claude). Leave unset to show "AI not configured".
ANTHROPIC_API_KEY=
# Optional overrides
SCRIBE_AI_PROVIDER=
SCRIBE_AI_MODEL=
SCRIBE_AI_BASE_URL=
SCRIBE_AI_API_KEY=

# Optional: comma-separated extra origins allowed to call the API (default: same origin only).
ALLOWED_ORIGINS=
