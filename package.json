{
  "name": "scribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"node --watch server/index.js\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "node scripts/make-fixtures.mjs",
    "verify:python-docx": "python3 -I scripts/verify-python-docx.py tests/output"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@tiptap/extension-collaboration": "^3.35.0",
    "@tiptap/extension-collaboration-caret": "^3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-subscript": "^3.35.0",
    "@tiptap/extension-superscript": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "dompurify": "^3.5.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "lib0": "^0.2.120",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "docx": "^9.16.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
